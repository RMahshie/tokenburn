#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -ne 1 ]; then
  echo "usage: scripts/release v1.0.1" >&2
  exit 2
fi

tag="$1"

case "$tag" in
  v[0-9]*.[0-9]*.[0-9]*) ;;
  *)
    echo "tag must look like v1.0.1" >&2
    exit 2
    ;;
esac

branch="$(git branch --show-current)"
if [ "$branch" != "main" ]; then
  echo "release from main, not $branch" >&2
  exit 1
fi

git fetch origin main --tags

if [ "$(git rev-parse HEAD)" != "$(git rev-parse origin/main)" ]; then
  echo "local main is not exactly origin/main; pull or push first" >&2
  exit 1
fi

if [ -n "$(git status --porcelain)" ]; then
  echo "worktree is dirty; commit or stash changes first" >&2
  git status --short
  exit 1
fi

if git rev-parse -q --verify "refs/tags/$tag" >/dev/null; then
  echo "local tag already exists: $tag" >&2
  exit 1
fi

if git ls-remote --exit-code --tags origin "refs/tags/$tag" >/dev/null 2>&1; then
  echo "remote tag already exists: $tag" >&2
  exit 1
fi

cargo test

git tag "$tag"
git push origin "$tag"

echo "pushed $tag; GitHub Actions will build and publish the release"
